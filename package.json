{
  "name": "@lcx/wdk-protocol-swidge-lcx-liberty",
  "version": "1.0.0-beta.1",
  "description": "WDK swidge module for LCX Liberty DEX: same-chain swaps and cross-chain swap-and-bridge routes on EVM chains, priced across every venue LCX Liberty DEX indexes, with no protocol fee.",
  "keywords": [
    "wdk",
    "protocol",
    "swidge",
    "swap",
    "bridge",
    "lcx",
    "lcx-liberty-dex",
    "dex-aggregator"
  ],
  "author": "LCX Liberty Labs Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LCX-AG/wdk-protocol-swidge-lcx-liberty.git"
  },
  "bugs": {
    "url": "https://github.com/LCX-AG/wdk-protocol-swidge-lcx-liberty/issues"
  },
  "main": "index.js",
  "type": "module",
  "types": "./types",
  "scripts": {
    "build:types": "tsc",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "e2e": "node tests/e2e/fork-base.js"
  },
  "dependencies": {
    "@tetherto/wdk-wallet": "^1.0.0-beta.15",
    "bare-node-runtime": "^1.1.4"
  },
  "devDependencies": {
    "@tetherto/wdk-wallet-evm": "^1.0.0-beta.10",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "standard": "^17.1.2",
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "standard": {
    "ignore": [
      "bare.js",
      "tests/**/*.js"
    ]
  },
  "homepage": "https://dex.lcx.com/business",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
